<?xml version="1.0" encoding="utf-8"?>
<!-- Round glass button that turns solid white when focused (tvOS Control Center style). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF2F1EE" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</selector>
