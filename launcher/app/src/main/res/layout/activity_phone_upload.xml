<?xml version="1.0" encoding="utf-8"?>
<!-- "From your phone": QR code on the right, what to do on the left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="80dp"
        android:paddingEnd="80dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="48dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bg_phone_title"
                android:textColor="#FFFFFFFF"
                android:textSize="38sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/bg_phone_steps"
                android:textColor="#D9FFFFFF"
                android:textSize="18sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />

            <TextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFF3C969"
                android:textSize="24sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/bg_phone_waiting"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <!-- White card: QR scanners need a light quiet zone around the code. -->
        <ImageView
            android:id="@+id/qr"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_qr_card"
            android:padding="14dp"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
