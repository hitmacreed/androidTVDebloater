<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Wallpaper kept faint: the shelf light should read against near-black, as on tvOS. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <!-- Shelf light in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Fades the shelf light to black behind the dock so the tiles stay readable. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_shelf_shade" />

    <!-- Top shelf: the focused dock app's name and status, lifted above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:orientation="vertical">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="58sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:shadowColor="#66000000"
            android:shadowDy="3"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/heroDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#D9FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:singleLine="true"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Left: NLRC wordmark and the time-of-day greeting on one line. -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="12dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nlrc_brand"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:letterSpacing="0.04"
                    android:includeFontPadding="false" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/brand_dot" />

                <TextView
                    android:id="@+id/fatherGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/greeting_afternoon"
                    android:textColor="#FFF3C969"
                    android:textSize="18sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Right: clock and date, then the Inputs / Wi-Fi / Settings pills. -->
            <LinearLayout
                android:id="@+id/rightBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp"
                        android:format12Hour="EEEE d MMMM"
                        android:format24Hour="EEEE d MMMM"
                        android:textColor="#A6FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400" />

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="32sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/topButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnInputs"
                        style="@style/TopButton"
                        android:text="@string/inputs"
                        android:drawableStart="@drawable/ic_input"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnWifi"
                        style="@style/TopButton"
                        android:text="@string/wifi"
                        android:drawableStart="@drawable/ic_wifi"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopButton"
                        android:text="@string/settings"
                        android:drawableStart="@drawable/ic_settings"
                        android:nextFocusDown="@+id/grid" />
                </LinearLayout>

                <!-- Installed build, so support can tell which version a TV runs. Set in MainActivity. -->
                <TextView
                    android:id="@+id/appVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="8dp"
                    android:focusable="false"
                    android:textColor="#4DFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400" />
            </LinearLayout>
        </RelativeLayout>

        <!-- App Grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tells first-time users the full app grid is below the dock; placed under the dock in code. -->
    <TextView
        android:id="@+id/moreAppsHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="70dp"
        android:alpha="0"
        android:text="@string/more_apps"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:visibility="gone" />

</FrameLayout>
